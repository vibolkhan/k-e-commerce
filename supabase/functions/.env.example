# Secrets for Edge Functions. Copy to supabase/functions/.env for
# `supabase functions serve`, and set them on the project with
# `supabase secrets set --env-file supabase/functions/.env`. Never commit .env.

# notify (F07) · Firebase service account with the "Firebase Cloud Messaging
# API Admin" role (Project settings › Service accounts › Generate key).
# Without these the inbox works and pushes are only logged.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The JSON key's private_key, with its \n escapes kept, in double quotes.
FCM_PRIVATE_KEY=

# Where the web app is served, so a web push opens the right page.
APP_WEB_URL=

# Lets a signed-in user send a `test` notification to themselves (S-08d dev
# tool). Dev and staging only — leave unset in production.
NOTIFY_SELF_TEST=true
